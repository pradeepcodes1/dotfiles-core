{{- if eq .chezmoi.os "linux" -}}
#!/usr/bin/env zsh
# Install missing Arch packages without refreshing databases or upgrading the
# rest of the system. Full Arch upgrades remain an explicit maintenance step.
set -e

source "${HOME}/.config/zsh/00-logging.zsh"

if [ -n "$CHEZMOI_SKIP_PACMAN" ]; then
	info_log "pacman" "Skipping machine-wide pacman package install for this apply"
	exit 0
fi

if ! command -v pacman >/dev/null 2>&1; then
	error_log "pacman" "pacman backend selected but pacman is unavailable"
	exit 1
fi

package_file="$HOME/.config/pacman/packages"
typeset -a packages privilege
packages=("${(@f)$(awk 'NF && $1 !~ /^#/' "$package_file")}")

if ((EUID == 0)); then
	privilege=()
elif command -v sudo >/dev/null 2>&1; then
	privilege=(sudo)
elif command -v doas >/dev/null 2>&1; then
	privilege=(doas)
else
	error_log "pacman" "Installing system packages requires root, sudo, or doas"
	exit 1
fi

info_log "pacman" "Installing missing packages from $package_file..."
"${privilege[@]}" pacman -S --needed --noconfirm -- "${packages[@]}"
info_log "pacman" "pacman package install complete"
{{- end }}
