{{- if eq .chezmoi.os "linux" -}}
#!/usr/bin/env zsh
# Install missing Arch packages as part of a full system upgrade. Arch does not
# support installing packages against stale sync databases (partial upgrades).
set -e

source "${HOME}/.config/zsh/00-logging.zsh"

if [ -n "$CHEZMOI_SKIP_PACMAN" ]; then
	info_log "pacman" "Skipping machine-wide pacman package install for this apply"
	exit 0
fi

if ! command -v pacman >/dev/null 2>&1; then
	error_log "pacman" "pacman backend selected but pacman is unavailable"
	exit 1
fi

package_file="$HOME/.config/pacman/packages"
typeset -a packages missing privilege
# Split with unquoted ${(f)...}, which drops empty fields. The quoted
# "${(@f)$(...)}" form yields an array holding one empty string when the command
# prints nothing, so an up-to-date machine used to skip the early exit, report
# "1 missing package", and hand pacman an empty target ("error: target not
# found") instead of saying everything was already installed.
packages=(${(f)"$(awk 'NF && $1 !~ /^#/' "$package_file")"})

if ((${#packages} == 0)); then
	error_log "pacman" "No packages listed in ${package_file}"
	exit 1
fi

debug_log "pacman" "Managed packages (${#packages}): ${(j: :)packages}"
missing=(${(f)"$(pacman -T -- "${packages[@]}" || true)"})

if ((${#missing} == 0)); then
	info_log "pacman" "All ${#packages} managed packages are already installed"
	exit 0
fi

if ((EUID == 0)); then
	privilege=()
elif command -v sudo >/dev/null 2>&1; then
	privilege=(sudo)
elif command -v doas >/dev/null 2>&1; then
	privilege=(doas)
else
	error_log "pacman" "Installing system packages requires root, sudo, or doas"
	exit 1
fi

info_log "pacman" "Installing ${#missing} missing packages with a full system upgrade: ${(j: :)missing}"
debug_log "pacman" "Running: ${(j: :)privilege} pacman -Syu --needed --noconfirm -- ${(j: :)missing}"

if ! "${privilege[@]}" pacman -Syu --needed --noconfirm -- "${missing[@]}"; then
	error_log "pacman" "pacman failed while installing: ${(j: :)missing}"
	exit 1
fi

info_log "pacman" "pacman package install complete"
{{- end }}
