#!/bin/sh
# prevent direct applies from bypassing bootstrap's prerequisite checks.
set -e

# Skip check in CI environments
[ -n "$CI" ] && exit 0

# If running via bootstrap.sh, CHEZMOI_BOOTSTRAP_MODE is set
if [ -z "$CHEZMOI_BOOTSTRAP_MODE" ]; then
  echo "ERROR: Run ./bootstrap.sh instead of 'chezmoi apply' directly"
  exit 1
fi
