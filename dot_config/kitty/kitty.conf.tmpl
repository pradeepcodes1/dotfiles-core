# make Kitty the primary terminal and multiplexer with one coherent shortcut layer.
# kitty — configured as the only multiplexer. No tmux accommodations.
#
# Ctrl is the portable Kitty shortcut modifier on both macOS and Linux. These
# mappings intentionally take precedence over matching terminal and shell keys.

include themes.conf

# ── Font and text rendering ───────────────────────────────────────────────
# Use a visibly different installed Nerd Font to verify Kitty honors family selection.
font_family       Maple Mono NF
font_size         15
# Ligatures on, but broken apart under the cursor so you see real characters.
# disable_ligatures cursor
{{- if eq .chezmoi.os "darwin" }}
# Use Kitty's native macOS composition so light text retains its intended contrast.
text_composition_strategy platform
{{- end }}
# Preserve color hues when correcting contrast; a bare number instead forces black or white.
#text_fg_override_threshold 4.5 ratio
# Keep text fully legible when the Kitty window or one of its splits loses focus.
inactive_text_alpha 1.0

# ── Performance ───────────────────────────────────────────────────────────
# Default repaint_delay is 10ms (~100fps). Lower it for ProMotion displays.
repaint_delay   6
input_delay     2
sync_to_monitor yes

# ── Window chrome and layout ──────────────────────────────────────────────
hide_window_decorations no
window_padding_width    4
window_border_width     1pt
draw_minimal_borders    yes
# "splits" gives tmux-style dynamic splitting; "stack" is the zoom target.
enabled_layouts         splits:split_axis=horizontal,stack
# Close without asking. 2 used to put a confirmation dialog in front of any
# window holding more than one kitty window; 0 turns that off entirely, so
# closing a window or quitting just happens.
confirm_os_window_close 0
{{- if eq .chezmoi.os "darwin" }}
macos_quit_when_last_window_closed yes
# macos_titlebar_color               background
{{- end }}

# ── Tab bar ───────────────────────────────────────────────────────────────
tab_bar_edge top

# ── Scrollback ────────────────────────────────────────────────────────────
# kitty stores scrollback compressed; 100k lines is cheap and means build
# output survives. Overflow spills to a temp file up to 64MB.
scrollback_lines                100000
scrollback_pager_history_size   64
scrollback_fill_enlarged_window yes
scrollback_pager less --chop-long-lines --RAW-CONTROL-CHARS +INPUT_LINE_NUMBER
# Keep Kitty's interactive scrollbar visible whenever this window has history.
scrollbar                       always

# ── Cursor ────────────────────────────────────────────────────────────────
cursor_shape         block
cursor_blink_interval 0

# No cursor trail/smear. 0 disables it (kitty's own default).
#
# This was `cursor_trail 3`, which reads like "trail on jumps of 3+ cells" but
# is not: the value is a number of *milliseconds*, and the trail is drawn for
# any cursor that held its position longer than that. At 3ms it fired on
# essentially every movement. The cells-based knob is a separate option,
# cursor_trail_start_threshold (default 2). If the trail is ever wanted again,
# a sane pair is `cursor_trail 30` plus `cursor_trail_start_threshold 5`, so it
# only appears on real jumps rather than ordinary typing.
cursor_trail         0

# ── Mouse ─────────────────────────────────────────────────────────────────
copy_on_select      yes
focus_follows_mouse yes
mouse_hide_wait     3.0
detect_urls         yes
underline_hyperlinks hover
show_hyperlink_targets cmd

# ── Shell integration ─────────────────────────────────────────────────────
# Gives prompt/command boundaries: prompt jumping, cwd inheritance in new
# splits, and completion notifications.
shell_integration    enabled
notify_on_cmd_finish invisible 10.0

# ── Remote control ────────────────────────────────────────────────────────
# Permit only the two colour operations used by `kitten themes` and the SSH
# integration. Windows launched with `--allow-remote-control` retain their
# private socketpair for scoped workflows such as returning Yazi's cwd; no
# global socket is open.
#
# Palette switching deliberately does not come through here. With no
# `listen_on`, remote control is unreachable from outside a kitty window, so a
# colour-scheme hook run by the desktop could never use it; the theme adapter
# reloads running instances with SIGUSR1 instead. See theme/apps/kitty.zsh.
allow_remote_control password
remote_control_password "" set-colors set-tab-color

{{- if eq .chezmoi.os "darwin" }}

# ── Environment ───────────────────────────────────────────────────────────
# GUI launches need Homebrew on PATH; shell functions still require `zsh -ic`.
env PATH={{ template "homebrew-prefix.tmpl" . }}/bin:{{ template "homebrew-prefix.tmpl" . }}/sbin:${PATH}

# ── Keyboard ──────────────────────────────────────────────────────────────
# Both Options act as Alt/Meta, so Meta keybindings work in shell and nvim.
macos_option_as_alt both
{{- end }}

# ── Bell ──────────────────────────────────────────────────────────────────
enable_audio_bell    no
window_alert_on_bell yes
bell_on_tab          "🔔 "

# ══ Keybindings ═══════════════════════════════════════════════════════════

# ── Splits ────────────────────────────────────────────────────────────────
# Spell Ctrl+| as its physical chord so Kitty sees the Shift modifier.
map ctrl+backslash       launch --location=vsplit --cwd=current
map ctrl+shift+backslash launch --location=hsplit --cwd=current

# Keep unshifted Ctrl+H/J/K/L available to Neovim; Shift selects Kitty splits.
map ctrl+shift+j neighboring_window down
map ctrl+shift+k neighboring_window up

map ctrl+shift+h move_window left
map ctrl+shift+l move_window right

# Keep Ctrl+R available to the shell so Atuin can open its history search.
map ctrl+r send_key ctrl+r
# Forward Ctrl+D instead of letting Kitty open documentation, preserving Neovim's half-page scroll.
map ctrl+d send_key ctrl+d
# Zoom the focused split to fill the tab, and back.
map ctrl+z toggle_layout stack
# Cycle splits without thinking about direction.
map ctrl+grave_accent next_window

# ── Tabs ──────────────────────────────────────────────────────────────────
# Always start a local shell in $HOME. `new_tab_with_cwd` asks the ssh kitten
# to clone a remote cwd when the focused window is an ssh session.
map ctrl+t     launch --type=tab --cwd={{ .chezmoi.homeDir }}
map ctrl+w     close_window
map ctrl+alt+w close_tab
map ctrl+]     next_tab
map ctrl+[     previous_tab
map ctrl+shift+] move_tab_forward
map ctrl+shift+[ move_tab_backward
map ctrl+1 goto_tab 1
map ctrl+2 goto_tab 2
map ctrl+3 goto_tab 3
map ctrl+4 goto_tab 4
map ctrl+5 goto_tab 5
map ctrl+6 goto_tab 6
map ctrl+7 goto_tab 7
map ctrl+8 goto_tab 8
map ctrl+9 goto_tab 9

map ctrl+n new_os_window_with_cwd

# tmux session picker, on demand. The picker no longer runs at shell startup
# (see dot_config/zsh/tmux.zsh); this is the only way in besides `tmux-picker`.
map ctrl+shift+t launch --type=tab --title tmux zsh -i -c tmux-picker

# Own tab, like tmux-picker above, rather than typed into the calling shell:
# cancelling the picker and finishing a session both just close that tab, and
# the shell it was launched from is left untouched either way. The wrapper
# sshm-window (dot_config/zsh/ssh.zsh) is sshm plus a pause on a failing exit,
# so a connection that never came up leaves its error on screen instead of
# taking the tab down with it.
map ctrl+m launch --type=tab --title ssh zsh -ic sshm-window

# A shell that has not run anything yet has no scrollback worth protecting, so
# take its window over with an overlay instead of opening a tab beside it. The
# shell_fresh user variable is set by the first prompt and dropped by the first
# command (dot_config/zsh/ssh.zsh); anything that never sets it - an editor, an
# ssh session, the picker's own short-lived shell - falls through to the tab
# binding above.
map --when-focus-on var:shell_fresh ctrl+m launch --type=overlay --title ssh zsh -ic sshm-window

# ── Scrollback and prompts ────────────────────────────────────────────────
# Ask Zsh to clear through its Ctrl+L widget. Unlike Kitty's
# `to_cursor_scroll`, the widget also discards text at the current prompt,
# clears retained scrollback, and redraws a fresh prompt. This takes over
# Kitty's own default for this chord on macOS (copy_to_clipboard) —
# copy_on_select already puts selections on the clipboard, and explicit copy
# moves to Ctrl+Shift+c.
map ctrl+l       send_key ctrl+l
# Forward Ctrl+C unchanged so it continues to interrupt the foreground process.
map ctrl+c       send_key ctrl+c
map ctrl+shift+c copy_to_clipboard
map ctrl+f    show_scrollback
# Alt keeps prompt jumping distinct from Ctrl+Shift+j/k window movement.
map ctrl+alt+k scroll_to_prompt -1
map ctrl+alt+j scroll_to_prompt 1
map ctrl+home scroll_home
map ctrl+end  scroll_end
# Page or copy OSC 133-delimited command output.
map ctrl+shift+y show_last_command_output
map ctrl+y launch --type=clipboard --stdin-source=@last_visited_cmd_output
# The same selection by mouse: click any prompt line to select that command's
# output. copy_on_select (set above) puts it on the clipboard.
mouse_map ctrl+shift+right press ungrabbed mouse_select_command_output

# ── Hints kitten — keyboard-driven selection, no mouse ─────────────────────
# Open a URL by keyboard.
map ctrl+p>u kitten hints --type url
# Insert a file path from the screen at the prompt.
map ctrl+p>f kitten hints --type path --program -
# Open a path in the editor.
map ctrl+p>e kitten hints --type path --program nvim
# Insert a line from the screen.
map ctrl+p>l kitten hints --type line --program -
# Insert a word.
map ctrl+p>w kitten hints --type word --program -
# Grab a git hash.
map ctrl+p>h kitten hints --type hash --program -

# ── Overlay popups ────────────────────────────────────────────────────────
# Portable defaults. Run Yazi through its shell wrapper in the current window
# so Ctrl+O can change that shell's directory when Yazi exits.
# The private macOS overlay replaces e/g/shift+g/i with
# ssh-aware versions (and adds shift+e and o) through local.d: a later `map`
# for the same chord wins, and local.d is globincluded at the end of this file.
map ctrl+e       send_text all \x20y\r
map ctrl+g       launch --type=overlay --cwd=current zsh -ic lazygit
map ctrl+shift+g launch --type=overlay --cwd=current serie

# Process explorer, whole machine rather than this window: btop has no PID-list
# filter (only `-f`, which matches on the command string), and the machine-wide
# view is the one worth having anyway. Alt keeps this off bare Ctrl+I, which
# Neovim's jumplist needs (the forward counterpart to Ctrl+O above).
map ctrl+alt+i launch --type=overlay btop

# Local repository summary, paged.
map ctrl+shift+i launch --type=overlay --cwd=current {{ .chezmoi.homeDir }}/.config/kitty/repo-stats.sh

# Browse/import from Gogh as the source of truth, then apply the selection
# across the dotfiles theme integrations (Kitty, shell, Neovim, and borders).
map ctrl+a launch --type=overlay zsh -ic "theme"

# Rename the current tab (the analogue of tmux's rename-session).
map ctrl+shift+comma set_tab_title

# ── Misc kittens ──────────────────────────────────────────────────────────
# Search the scrollback interactively.
map ctrl+shift+f launch --type=overlay --stdin-source=@screen_scrollback less --chop-long-lines --RAW-CONTROL-CHARS
# Unicode / emoji picker.
map ctrl+shift+u kitten unicode_input
# ── Font size ─────────────────────────────────────────────────────────────
map ctrl+equal change_font_size all +1.0
map ctrl+minus change_font_size all -1.0
map ctrl+0     change_font_size all 0

# ── Config ────────────────────────────────────────────────────────────────
map ctrl+shift+r load_config_file
map ctrl+shift+delete clear_terminal reset active

# ── Machine-local additions ───────────────────────────────────────────────
# Whatever a private overlay or a single machine wants on top of this file:
# extra bindings, platform-only actions, per-host overrides. `globinclude`
# rather than `include`, so a machine with no local.d is not an error, and it
# comes last so a `map` there overrides the same chord above.
globinclude local.d/*.conf
