# ensure edits happen in chezmoi source and applies pass through bootstrap.
# Config edit environment
# Drops into the chezmoi source directory for editing

config-apply() {
  "{{ .chezmoi.homeDir }}/.local/bin/dotfiles" apply "$@"
}

config-edit() {
  local chezmoi_source="{{ .chezmoi.sourceDir }}"

  if [[ ! -d "$chezmoi_source" ]]; then
    error_log "config-edit" "Chezmoi source directory not found at $chezmoi_source"
    return 1
  fi

  info_log "config-edit" "Entering chezmoi source directory..."
  echo ""
  echo "Available commands:"
  echo "  - Edit files directly in this directory"
  echo "  - Run 'dotfiles plan' to preview the complete layered apply"
  echo "  - Run 'dotfiles apply' to apply core and the active overlay"
  echo "  - Run 'dotfiles verify' for render, ownership, and security checks"
  echo "  - Run 'chezmoi status' to check file status"
  echo "  - Use 'git' for version control"
  echo ""

  cd "$chezmoi_source"
}
