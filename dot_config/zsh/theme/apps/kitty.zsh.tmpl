# apply the active Gogh palette to the running terminal immediately.
# Kitty theme integration

[[ -z "$gogh_theme" ]] && return

local kitty_config_dir="{{ .chezmoi.homeDir }}/.config/kitty"
local current_theme_file="$kitty_config_dir/current-theme.conf"
local state_dir="${XDG_STATE_HOME:-{{ .chezmoi.homeDir }}/.local/state}/dotfiles"
local state_file="$state_dir/kitty-theme"
local apply_reason="${_DOTFILES_THEME_APPLY_REASON:-init}"
local expected_state="gogh:${_DOTFILES_THEME_NAME}"
local color_name
local -a required_colors=(
  bg fg
  black red green yellow blue magenta cyan white
  bright_black bright_red bright_green bright_yellow
  bright_blue bright_magenta bright_cyan bright_white
)

for color_name in "${required_colors[@]}"; do
  if [[ -z "${(P)color_name}" ]]; then
    [[ "$apply_reason" == "command" ]] && warn_log "theme" "Gogh theme '$_DOTFILES_THEME_NAME' is missing '$color_name'; Kitty theme unchanged"
    return
  fi
done

local kitty_content="# Generated from the Gogh palette in $_DOTFILES_THEME_NAME.sh.
foreground $fg
background $bg
selection_foreground $bg
selection_background $fg
cursor $fg
cursor_text_color $bg
url_color $cyan

color0 $black
color1 $red
color2 $green
color3 $yellow
color4 $blue
color5 $magenta
color6 $cyan
color7 $white
color8 $bright_black
color9 $bright_red
color10 $bright_green
color11 $bright_yellow
color12 $bright_blue
color13 $bright_magenta
color14 $bright_cyan
color15 $bright_white"

if [[ "$apply_reason" != "command" && -f "$current_theme_file" && -f "$state_file" \
  && "$(< "$current_theme_file")" == "$kitty_content" \
  && "$(< "$state_file")" == "$expected_state" ]]; then
  return
fi

mkdir -p "$kitty_config_dir" "$state_dir"

if [[ ! -f "$current_theme_file" ]] || [[ "$(< "$current_theme_file")" != "$kitty_content" ]]; then
  local temp_theme_file="${current_theme_file}.tmp.$$"
  if ! print -r -- "$kitty_content" > "$temp_theme_file" || ! mv -f "$temp_theme_file" "$current_theme_file"; then
    rm -f "$temp_theme_file"
    [[ "$apply_reason" == "command" ]] && warn_log "theme" "Failed to save Gogh palette for Kitty"
    return
  fi
fi

mkdir -p "$state_dir"

# Persisting current-theme.conf covers new windows: kitty.conf includes
# themes.conf, which includes this file. SIGUSR1 makes every running instance
# re-read that chain, so already-open windows pick the palette up as well.
#
# This deliberately does not use `kitten @ set-colors`. Remote control is only
# reachable over a socket (`listen_on`, which is not set) or the private
# socketpair a window inherits, exposed as $KITTY_LISTEN_ON. A palette change
# driven from outside kitty -- a desktop colour-scheme hook, say -- has neither,
# so `kitten @` fell back to the controlling terminal and died with
# "open /dev/tty: no such device or address", leaving running windows stale
# while new ones came up correct. A signal needs no socket, no password grant
# and no tty, so it works from any parent.
#
# A non-zero exit just means no instance is running; the saved palette still
# applies to the next window opened, so it is not a failure worth warning about.
pkill -USR1 -x kitty 2>/dev/null

print -r -- "$expected_state" > "$state_file"
