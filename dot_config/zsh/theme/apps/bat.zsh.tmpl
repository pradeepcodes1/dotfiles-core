# keep syntax highlighting aligned with the active terminal palette.
# Bat theme integration
# Generated Gogh themes use bat's ANSI theme so syntax colors follow the
# terminal palette.

local bat_config="{{ .chezmoi.homeDir }}/.config/bat/config"
local resolved_bat_theme="$bat_theme"

# This mode-aware fallback only covers damaged or older generated files.
if [[ -z "$resolved_bat_theme" ]]; then
  if [[ "$_DOTFILES_THEME_MODE" == "light" ]]; then
    resolved_bat_theme="OneHalfLight"
  else
    resolved_bat_theme="TwoDark"
  fi
fi

local bat_content="--theme=\"$resolved_bat_theme\""

mkdir -p "$(dirname "$bat_config")"
if [[ ! -f "$bat_config" ]] || [[ "$(< "$bat_config")" != "$bat_content" ]]; then
  print -r -- "$bat_content" > "$bat_config"
fi
