# keep file-manager colors synchronized with the active Gogh palette.
# Yazi theme integration

local yazi_config="{{ .chezmoi.homeDir }}/.config/yazi/theme.toml"
local yazi_content

if [[ -n "$gogh_theme" ]]; then
  # This is intentionally a direct theme.toml override rather than a generated
  # flavor directory: flavors also require package metadata and a tmTheme file.
  yazi_content="#:schema https://yazi-rs.github.io/schemas/theme.json
# Generated from Gogh with readable UI surfaces and badge foregrounds.

[app]
overall = { bg = \"$bg\" }

[mgr]
cwd = { fg = \"$theme_ui_cyan\" }
find_keyword = { fg = \"$theme_ui_yellow\", bold = true, italic = true, underline = true }
find_position = { fg = \"$theme_ui_magenta\", bg = \"$bg\", bold = true, italic = true }
symlink_target = { fg = \"$theme_ui_cyan\", italic = true }
marker_copied = { fg = \"$theme_ui_green\", bg = \"$theme_ui_green\" }
marker_cut = { fg = \"$theme_ui_red\", bg = \"$theme_ui_red\" }
marker_marked = { fg = \"$theme_ui_cyan\", bg = \"$theme_ui_cyan\" }
marker_selected = { fg = \"$theme_ui_yellow\", bg = \"$theme_ui_yellow\" }
count_copied = { fg = \"$theme_ui_on_green\", bg = \"$theme_ui_green\" }
count_cut = { fg = \"$theme_ui_on_red\", bg = \"$theme_ui_red\" }
count_selected = { fg = \"$theme_ui_on_yellow\", bg = \"$theme_ui_yellow\" }
border_symbol = \"│\"
border_style = { fg = \"$theme_ui_border\" }

[tabs]
active = { fg = \"$theme_ui_on_blue\", bg = \"$theme_ui_blue\", bold = true }
inactive = { fg = \"$theme_ui_fg\", bg = \"$theme_ui_surface\" }

[mode]
normal_main = { fg = \"$theme_ui_on_blue\", bg = \"$theme_ui_blue\", bold = true }
normal_alt = { fg = \"$theme_ui_blue\", bg = \"$theme_ui_surface\" }
select_main = { fg = \"$theme_ui_on_magenta\", bg = \"$theme_ui_magenta\", bold = true }
select_alt = { fg = \"$theme_ui_magenta\", bg = \"$theme_ui_surface\" }
unset_main = { fg = \"$theme_ui_on_red\", bg = \"$theme_ui_red\", bold = true }
unset_alt = { fg = \"$theme_ui_red\", bg = \"$theme_ui_surface\" }

[indicator]
parent = { reversed = true }
current = { reversed = true }
preview = { underline = true }

[status]
overall = { fg = \"$theme_ui_fg\", bg = \"$bg\" }
perm_sep = { fg = \"$theme_ui_muted\" }
perm_type = { fg = \"$theme_ui_green\" }
perm_read = { fg = \"$theme_ui_yellow\" }
perm_write = { fg = \"$theme_ui_red\" }
perm_exec = { fg = \"$theme_ui_cyan\" }
progress_label = { fg = \"$theme_ui_fg\", bold = true }
progress_normal = { fg = \"$theme_ui_green\", bg = \"$theme_ui_surface\" }
progress_error = { fg = \"$theme_ui_on_red\", bg = \"$theme_ui_red\" }

[which]
mask = { bg = \"$theme_ui_surface\" }
cand = { fg = \"$theme_ui_cyan\" }
rest = { fg = \"$theme_ui_muted\" }
desc = { fg = \"$theme_ui_magenta\" }
separator_style = { fg = \"$theme_ui_muted\" }

[confirm]
border = { fg = \"$theme_ui_blue\" }
title = { fg = \"$theme_ui_blue\" }
btn_yes = { fg = \"$theme_ui_green\", reversed = true }
btn_no = { fg = \"$theme_ui_red\" }

[spot]
border = { fg = \"$theme_ui_blue\" }
title = { fg = \"$theme_ui_blue\" }
tbl_col = { fg = \"$theme_ui_cyan\" }
tbl_cell = { fg = \"$theme_ui_yellow\", reversed = true }

[notify]
title_info = { fg = \"$theme_ui_green\" }
title_warn = { fg = \"$theme_ui_yellow\" }
title_error = { fg = \"$theme_ui_red\" }

[pick]
border = { fg = \"$theme_ui_blue\" }
active = { fg = \"$theme_ui_magenta\", bold = true }
inactive = { fg = \"$theme_ui_fg\" }

[input]
border = { fg = \"$theme_ui_blue\" }
title = { fg = \"$theme_ui_fg\" }
value = { fg = \"$theme_ui_fg\" }
selected = { reversed = true }

[cmp]
border = { fg = \"$theme_ui_blue\" }
active = { fg = \"$theme_ui_fg\", reversed = true }
inactive = { fg = \"$theme_ui_muted\" }

[tasks]
border = { fg = \"$theme_ui_blue\" }
title = { fg = \"$theme_ui_fg\" }
hovered = { fg = \"$theme_ui_magenta\", bold = true }

[filetype]
rules = [
  { mime = \"**/image/*\", fg = \"$theme_ui_yellow\" },
  { mime = \"**/{audio,video}/*\", fg = \"$theme_ui_magenta\" },
  { mime = \"**/application/{zip,rar,7z*,tar,gzip,xz,zstd,bzip*,lzma,compress,archive,cpio,arj,xar,ms-cab*}\", fg = \"$theme_ui_red\" },
  { mime = \"**/application/{pdf,doc,rtf,vnd.*}\", fg = \"$theme_ui_cyan\" },
  { mime = \"vfs/{absent,stale}\", fg = \"$theme_ui_muted\" },
  { url = \"*\", is = \"orphan\", fg = \"$theme_ui_red\" },
  { url = \"*\", is = \"exec\", fg = \"$theme_ui_green\" },
  { url = \"*\", fg = \"$theme_ui_fg\" },
  { url = \"*/\", fg = \"$theme_ui_blue\" },
]"
else
  return
fi

mkdir -p "$(dirname "$yazi_config")"
if [[ ! -f "$yazi_config" ]] || [[ "$(< "$yazi_config")" != "$yazi_content" ]]; then
  print -r -- "$yazi_content" > "$yazi_config" || return 1
fi

# An unchanged generated file is a successful application.
return 0
