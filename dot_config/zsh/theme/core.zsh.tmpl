# share theme detection, parsing, and persistence across every adapter.
# Core theme functions

# Report the desktop's light/dark preference. Only reached before a theme has
# ever been chosen on this machine: _init_theme reads the persisted theme file
# first, and a `theme` switch writes one.
#
# This used to be _detect_macos_theme and ran `defaults` unconditionally. On
# Linux that command does not exist, the &>/dev/null swallowed the failure, and
# every fresh machine silently took the light branch.
_detect_system_theme() {
  if [[ "$OSTYPE" == darwin* ]]; then
    # macOS writes this key only in dark mode; in light mode it is absent.
    if defaults read -g AppleInterfaceStyle &>/dev/null; then
      echo "dark"
    else
      echo "light"
    fi
    return
  fi

  # Linux has no single source of truth. gsettings answers wherever something
  # honours the freedesktop appearance key -- a desktop's settings daemon, or a
  # portal under a bare compositor -- and is simply absent otherwise.
  if (( $+commands[gsettings] )); then
    case "$(gsettings get org.gnome.desktop.interface color-scheme 2>/dev/null)" in
      *prefer-dark*) echo "dark"; return ;;
      *prefer-light*) echo "light"; return ;;
    esac
  fi

  # No gsettings, or it reported "default", which expresses no preference.
  # Dark is this configuration's default pick.
  echo "dark"
}

# Extract a metadata field from a theme color file header comment
# Usage: _get_theme_field "color_file_path" "Field"
_get_theme_field() {
  grep "^# $2:" "$1" | cut -d: -f2- | tr -d ' '
}

# Every generated key, plus the two former registry keys retained only so a
# shell reload clears their old values. Keep this synchronized with gogh.zsh.
_DOTFILES_THEME_KEYS=(
  bg fg
  black red green yellow blue magenta cyan white
  bright_black bright_red bright_green bright_yellow
  bright_blue bright_magenta bright_cyan bright_white
  prompt_dir prompt_branch prompt_unstaged prompt_staged prompt_arrow prompt_path
  ui_bg ui_fg ui_accent ui_border ui_active ui_inactive
  nvim_colorscheme nvim_lualine nvim_background
  bat_theme eza_theme gogh_theme gogh_format
  kitty_theme yazi_flavor
)

_reset_theme_vars() {
  unset "${_DOTFILES_THEME_KEYS[@]}"
}

# Export when set, unset when not. Never export an empty value: Neovim reads
# these with `vim.env.X or "default"`, and an empty string is truthy in Lua,
# which would defeat the fallback.
_export_or_unset() {
  if [[ -n "$2" ]]; then
    export "$1=$2"
  else
    unset "$1"
  fi
}

_load_theme_colors() {
  local theme_name="$1"
  local color_file

  color_file="$(_theme_color_file "$theme_name")" || return 1

  _reset_theme_vars
  source "$color_file" || return 1

  # Separate UI surfaces from ANSI slots; old imported palettes need no migration.
  local ui_roles ui_line ui_key ui_value
  # ui-colors.py is a pure function of the eight palette colors below, so its
  # output can only change when the palette file or the script itself does.
  # Caching it keeps a python3 fork -- around 22ms -- out of the startup of
  # every interactive shell, which reloads the same theme it loaded last time.
  local ui_cache="$_DOTFILES_THEME_CACHE_DIR/${theme_name}.ui"
  if [[ -s "$ui_cache" && "$ui_cache" -nt "$color_file" && "$ui_cache" -nt "$_theme_dir/ui-colors.py" ]]; then
    ui_roles="$(< "$ui_cache")"
  else
    ui_roles=$(python3 "$_theme_dir/ui-colors.py" "$bg" "$fg" "$red" "$green" "$yellow" "$blue" "$magenta" "$cyan") || return 1
    # Publish through a temp file so a shell starting concurrently either reads
    # the previous cache or the complete new one, never a half-written palette.
    # A cache that cannot be written is not fatal: the fork above still answered.
    local ui_temp
    if mkdir -p "${ui_cache:h}" 2>/dev/null && ui_temp=$(mktemp "${ui_cache}.XXXXXX" 2>/dev/null); then
      print -r -- "$ui_roles" > "$ui_temp" && mv -f "$ui_temp" "$ui_cache" || rm -f "$ui_temp"
    fi
  fi
  for ui_line in "${(@f)ui_roles}"; do
    ui_key="${ui_line%%=*}"
    ui_value="${ui_line#*=}"
    typeset -g "$ui_key=$ui_value"
  done

  export _DOTFILES_THEME_NAME="$theme_name"
  export _DOTFILES_THEME_MODE=$(_get_theme_field "$color_file" "Mode")

  _export_or_unset _DOTFILES_NVIM_COLORSCHEME "$nvim_colorscheme"
  _export_or_unset _DOTFILES_NVIM_LUALINE "$nvim_lualine"
  _export_or_unset _DOTFILES_NVIM_BACKGROUND "$nvim_background"
  return 0
}

_theme_color_file() {
  local theme_name="$1"

  # State and command arguments become path components, so reject traversal and
  # names outside the format used by generated Gogh themes.
  [[ "$theme_name" =~ '^[A-Za-z0-9][A-Za-z0-9._-]*$' ]] || return 1

  if [[ -f "$_DOTFILES_GOGH_THEMES_DIR/${theme_name}.sh" ]]; then
    print -r -- "$_DOTFILES_GOGH_THEMES_DIR/${theme_name}.sh"
    return 0
  fi

  return 1
}

_ensure_theme_available() {
  local theme_name="$1"
  local color_file

  color_file="$(_theme_color_file "$theme_name")" || color_file=""
  [[ -n "$color_file" ]] && grep -qx 'gogh_format=2' "$color_file" && return 0
  [[ "$theme_name" == gogh-* ]] || return 1

  _gogh_import_slug "${theme_name#gogh-}"
}
