# share theme detection, parsing, and persistence across every adapter.
# Core theme functions

_detect_macos_theme() {
  if defaults read -g AppleInterfaceStyle &>/dev/null; then
    echo "dark"
  else
    echo "light"
  fi
}

# Extract a metadata field from a theme color file header comment
# Usage: _get_theme_field "color_file_path" "Field"
_get_theme_field() {
  grep "^# $2:" "$1" | cut -d: -f2- | tr -d ' '
}

# Every key a color file may define. Cleared before sourcing a new theme so a
# key the incoming theme omits cannot inherit the outgoing theme's value.
# Keep in sync with the contract in ~/.config/colors/README.md.
_DOTFILES_THEME_KEYS=(
  bg fg
  black red green yellow blue magenta cyan white
  bright_black bright_red bright_green bright_yellow
  bright_blue bright_magenta bright_cyan bright_white
  prompt_dir prompt_branch prompt_unstaged prompt_staged prompt_arrow prompt_path
  ui_bg ui_fg ui_accent ui_border ui_active ui_inactive
  nvim_colorscheme nvim_lualine nvim_background
  kitty_theme bat_theme eza_theme yazi_flavor gogh_theme
)

_reset_theme_vars() {
  unset "${_DOTFILES_THEME_KEYS[@]}"
}

# Export when set, unset when not. Never export an empty value: Neovim reads
# these with `vim.env.X or "default"`, and an empty string is truthy in Lua,
# which would defeat the fallback.
_export_or_unset() {
  if [[ -n "$2" ]]; then
    export "$1=$2"
  else
    unset "$1"
  fi
}

_load_theme_colors() {
  local theme_name="$1"
  local color_file

  color_file="$(_theme_color_file "$theme_name")" || return 1

  _reset_theme_vars
  source "$color_file"

  export _DOTFILES_THEME_NAME="$theme_name"
  export _DOTFILES_THEME_MODE=$(_get_theme_field "$color_file" "Mode")
  export _DOTFILES_THEME_TRANSPARENT=$(_get_theme_field "$color_file" "Transparent")

  _export_or_unset _DOTFILES_NVIM_COLORSCHEME "$nvim_colorscheme"
  _export_or_unset _DOTFILES_NVIM_LUALINE "$nvim_lualine"
  _export_or_unset _DOTFILES_NVIM_BACKGROUND "$nvim_background"
  return 0
}

_theme_color_file() {
  local theme_name="$1"

  # State and command arguments become path components, so reject traversal and
  # names outside the format used by both curated and imported themes.
  [[ "$theme_name" =~ '^[A-Za-z0-9][A-Za-z0-9._-]*$' ]] || return 1

  if [[ -f "$_DOTFILES_COLORS_DIR/${theme_name}.sh" ]]; then
    print -r -- "$_DOTFILES_COLORS_DIR/${theme_name}.sh"
    return 0
  fi

  if [[ -f "$_DOTFILES_GOGH_THEMES_DIR/${theme_name}.sh" ]]; then
    print -r -- "$_DOTFILES_GOGH_THEMES_DIR/${theme_name}.sh"
    return 0
  fi

  return 1
}

_get_available_themes() {
  local -A seen
  local dir f theme_name

  for dir in "$_DOTFILES_COLORS_DIR" "$_DOTFILES_GOGH_THEMES_DIR"; do
    [[ -d "$dir" ]] || continue
    for f in "$dir"/*.sh(N); do
      theme_name="${${f:t}%.sh}"
      [[ -n "${seen[$theme_name]:-}" ]] && continue
      seen[$theme_name]=1
      print -r -- "$theme_name"
    done
  done
}

_theme_fzf_pick() {
  local filter="$1"
  local themes_list=()

  for theme in $(_get_available_themes); do
    local color_file
    color_file="$(_theme_color_file "$theme")" || continue
    local mode=$(_get_theme_field "$color_file" "Mode")
    local current=""
    [[ "$theme" == "$_DOTFILES_THEME_NAME" ]] && current="*"

    if [[ "$filter" == "all" ]] || [[ "$filter" == "$mode" ]]; then
      themes_list+=("$current$theme [$mode]")
    fi
  done

  local selected
  selected=$(printf '%s\n' "${themes_list[@]}" | sort | fzf --prompt="Select theme: " --height=40% --reverse)

  if [[ -n "$selected" ]]; then
    local theme_name="${selected#\*}"
    echo "${theme_name%% \[*}"
  fi
}
