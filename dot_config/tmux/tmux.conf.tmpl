# retain an opt-in remote/session multiplexer with Kitty-compatible navigation.
# Prefix (Ctrl+a). Ctrl+l remains available to Zsh so Kitty's Cmd+c clear
# binding works the same way inside and outside tmux.
unbind C-b
set -g prefix C-a
bind C-a send-prefix

# Right Option key bindings (via Karabiner sending prefix + key)
# Window management
bind c new-window -c "#{pane_current_path}"                          # ROpt+c: new window
bind \; previous-window                                              # ROpt+;: previous window
bind "'" next-window                                                 # ROpt+': next window
bind 1 select-window -t :=1                                          # ROpt+1: window 1
bind 2 select-window -t :=2                                          # ROpt+2: window 2
bind 3 select-window -t :=3                                          # ROpt+3: window 3
bind 4 select-window -t :=4                                          # ROpt+4: window 4
bind 5 select-window -t :=5                                          # ROpt+5: window 5
bind 6 select-window -t :=6                                          # ROpt+6: window 6
bind 7 select-window -t :=7                                          # ROpt+7: window 7
bind 8 select-window -t :=8                                          # ROpt+8: window 8
bind 9 select-window -t :=9                                          # ROpt+9: window 9

# Pane management (h/j/k/l defined below)
unbind-key -q z                                                       # Disable tmux zoom/zen toggle
unbind-key -q >                                                       # Disable default pane menu exposing zoom

# Session management
bind d detach-client                                                 # ROpt+d: detach
bind s choose-session -Z                                             # ROpt+s: choose session

# Session switching by number (Shift+ROpt+1-9 via Karabiner sends prefix + shift+num)
bind '!' switch-client -t 1
bind '@' switch-client -t 2
bind '#' switch-client -t 3
bind '$' switch-client -t 4
bind '%' switch-client -t 5
bind '^' switch-client -t 6
bind '&' switch-client -t 7
bind '*' switch-client -t 8
bind '(' switch-client -t 9
# Shift+ROpt+c: new session, named at the prompt. Accepting the prompt empty
# falls back to the old MEX numbering; Escape cancels without creating one.
bind C command-prompt -p "new session:" "run-shell '{{ .chezmoi.targetFile | dir }}/new-session.py \"%1\"'"

# Copy mode
bind - copy-mode                                                     # ROpt+-: copy mode
# fzf needs a tty, which run-shell does not provide — hence the popup.
bind / run-shell 'tmux display-popup -E -w 80% -h 80% "{{ .chezmoi.targetFile | dir }}/relative-copy-mode.py #{pane_id}"'  # ROpt+/: copy mode with relative line numbers
bind n run-shell '{{ .chezmoi.targetFile | dir }}/notification-center.py'               # ROpt+n: notification center (bell)

set -g detach-on-destroy off
set -g mouse on
bind -T root MouseDown1Pane select-pane -t = \; send-keys -M
bind -T root MouseDrag1Pane if-shell -F "#{||:#{pane_in_mode},#{mouse_any_flag}}" "send-keys -M" "copy-mode -M"
bind -T root MouseDrag1Border resize-pane -M
bind -T root WheelUpPane if-shell -F "#{||:#{alternate_on},#{pane_in_mode},#{mouse_any_flag}}" "send-keys -M" "copy-mode -e"
bind -T root WheelDownPane if-shell -F "#{||:#{alternate_on},#{pane_in_mode},#{mouse_any_flag}}" "send-keys -M"
bind -T root S-WheelUpPane if-shell -F "#{||:#{alternate_on},#{pane_in_mode},#{mouse_any_flag}}" "send-keys -M" "copy-mode -eu"
bind -T root S-WheelDownPane if-shell -F "#{||:#{alternate_on},#{pane_in_mode},#{mouse_any_flag}}" "send-keys -M" "copy-mode -ed"
unbind-key -q -T root MouseDown3Pane
unbind-key -q -T root M-MouseDown3Pane
set -g focus-events on
set -s escape-time 0
set -g status-keys emacs
setw -g aggressive-resize on
set -g monitor-bell on
set -g bell-action any
set -g visual-bell off
set -g activity-action none
set-window-option -g mode-keys vi
set -g default-terminal "tmux-256color"
set -g status-position top
set -g status-justify left
set -g status-left ""
# Two status lines: slot 0 is the real bar, slot 1 is a blank spacer rendered in
# the pane background, giving the bar a one-row bottom margin.
set -g status 2
set -g 'status-format[1]' "#[fill=terminal,bg=terminal,fg=terminal,align=left,nolist,norange]"

set -g status-left-length 0
set -g status-right-length 100
set -g status-interval 15
set -g status-right ' #S#{?@ssh_host, | #{@ssh_host},} '
set -g display-time 1000
set-hook -gu after-select-window
set-hook -gu after-new-session
set-hook -gu after-new-window
set-hook -gu after-split-window
set-hook -gu after-kill-pane
set-hook -gu client-resized
set-hook -gu client-focus-in

# Source current theme (updated by theme.zsh to persist across tmux reloads)
run-shell 'tmux source-file ~/.config/tmux/themes/current.conf 2>/dev/null'

# Window renaming: let programs set titles via OSC, no auto-rename (Claude Code shows version as process name)
set -g automatic-rename off
set -g allow-rename on
set -g set-titles off

set -g history-limit 10000

# Window/pane numbering starts at 1, renumber on close
set -g base-index 1
setw -g pane-base-index 1
set -g renumber-windows on
# Split panes (\ horizontal, | vertical)
bind | split-window -v -p 40 -c "#{pane_current_path}"
bind \\ split-window -h -p 40 -c "#{pane_current_path}"
bind r source-file ~/.config/tmux/tmux.conf \; display-message "tmux reloaded"
bind C-p previous-window
bind C-n next-window
# Navigate panes with Vim keys (h,j,k,l) or Shift+Arrow
bind h select-pane -L
bind j select-pane -D
bind e run-shell 'tmux new-window -S -n yazi -c "#{pane_current_path}" "{{ .chezmoi.homeDir }}/.config/kitty/yazi-wrapper.py #{pane_id}"'  # ROpt+e: yazi
bind g display-popup -E -w 95% -h 90% -d "#{pane_current_path}" "lazygit"  # ROpt+g: lazygit
bind S-Left select-pane -L
bind S-Down select-pane -D
bind S-Up select-pane -U
bind S-Right select-pane -R

# Resize panes (+/= to grow, _ to shrink)
bind + resize-pane -U 5 \; resize-pane -R 5
bind _ resize-pane -D 5 \; resize-pane -L 5

# Restores `2`, not `on`: the bar is two rows (real bar + blank spacer, see
# `set -g status 2` above), and `on` would silently collapse it to one row
# with no way back short of reloading the config.
bind b if-shell -F '#{!=:#{status},off}' 'set -g status off' 'set -g status 2'

# Allow Kitty Graphics Protocol passthrough (for image.nvim and timg)
set -g allow-passthrough on

# Kitty terminal features
# RGB stops tmux quantizing truecolor to 256; usstyle enables colored/curly
# underlines; extkeys enables the Kitty keyboard protocol.
set -g terminal-features "xterm-kitty:RGB,hyperlinks,usstyle,extkeys"
set -g extended-keys on

# Set default cursor to underscore
set -g cursor-style underline

# Kill session and switch to next available (or create new)
bind-key X confirm-before -p "kill-session '#S'? (y/n)" "\
    if-shell '[ $(tmux list-sessions | wc -l) -gt 1 ]' \
        'switch-client -n \; kill-session -t \"#S\"' \
        'new-session \; kill-session -t \"#S\"' \
"
# Keep mouse selections highlighted in copy mode after releasing the drag.
bind -T copy-mode-vi MouseDragEnd1Pane send -X copy-selection-no-clear
bind -T copy-mode MouseDragEnd1Pane send -X copy-selection-no-clear
