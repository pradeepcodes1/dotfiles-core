# keep local tools and private agent state out of the dotfiles history.
# Binaries installed by chezmoi tooling
bin/
!dot_local/bin/
!dot_local/bin/executable_dotfiles

.claude/
.codex/
.DS_Store
.ruff_cache/
node_modules/
**/__pycache__/
*.pyc
*.bak
*.log
.nvimlog

# lazy.nvim writes this into the config dir it is run from; the deployed
# ~/.config/nvim owns it, not this source tree.
dot_config/nvim/lazy-lock.json
