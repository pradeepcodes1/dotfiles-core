# keep local tools and private agent state out of the dotfiles history.
# Binaries installed by chezmoi tooling
bin/
!dot_local/bin/
!dot_local/bin/executable_dotfiles

.claude/
.codex/
.DS_Store
.ruff_cache/
node_modules/
**/__pycache__/
*.pyc
*.bak
*.log
.nvimlog

# Keep lazy.nvim's resolved commits in the source tree so a restore recreates
# the same tested plugin graph instead of silently selecting newer revisions.
